{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mojilex.org/v1/dataset.schema.json",
  "title": "MojiLex dataset manifest v1",
  "type": "object",
  "required": [
    "dataset",
    "schema_version",
    "id_namespace",
    "visual_relation_namespace",
    "taxonomy_version",
    "color_profile",
    "color_profile_sha256",
    "dedupe_profile",
    "dedupe_profile_sha256",
    "collection_dedupe_profile",
    "collection_dedupe_profile_sha256",
    "default_languages",
    "platforms",
    "canonical_repository",
    "licenses"
  ],
  "properties": {
    "dataset": {
      "const": "mojilex"
    },
    "schema_version": {
      "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/schemaVersion"
    },
    "id_namespace": {
      "type": "string",
      "format": "uuid",
      "const": "47d42c76-38da-5ab5-90fe-7af0ba6c4a27"
    },
    "visual_relation_namespace": {
      "type": "string",
      "format": "uuid",
      "const": "4958ce2d-8120-5c3a-8755-a71d93c0c866"
    },
    "taxonomy_version": {
      "const": "1.0.0"
    },
    "color_profile": {
      "const": "color-v1"
    },
    "color_profile_sha256": {
      "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/sha256",
      "const": "c30dcf7241037e3c1e4c4a16686c4e899c3f81bae19bd741eb257e458f9986ae"
    },
    "dedupe_profile": {
      "const": "dedupe-v1"
    },
    "dedupe_profile_sha256": {
      "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/sha256",
      "const": "8f6eb6f68479897a8fe5be434ca2f081edcf4cb08cc1371308e732022f7c66c1"
    },
    "collection_dedupe_profile": {
      "const": "collection-dedupe-v1"
    },
    "collection_dedupe_profile_sha256": {
      "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/sha256",
      "const": "a03a1979980c6e23323cac02459fa7a29bf68c858c45d2b52b9a54857766cf01"
    },
    "default_languages": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "contains": {
        "const": "ru"
      },
      "items": {
        "type": "string",
        "pattern": "^(?:[A-Za-z]{2,3})(?:-[A-Za-z0-9]{2,8})*$"
      },
      "allOf": [
        {
          "contains": {
            "const": "en"
          }
        }
      ]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "telegram"
      },
      "items": {
        "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/platform"
      }
    },
    "canonical_repository": {
      "const": "https://github.com/MojiLex/mojilex"
    },
    "licenses": {
      "type": "object",
      "required": [
        "data",
        "code"
      ],
      "properties": {
        "data": {
          "const": "CC0-1.0"
        },
        "code": {
          "const": "MIT"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
